<Project>
  <ItemGroup>
    <!-- Roslyn. Analyzer floor is 4.8.0; CLI, Graph and language server override to 5.0.0. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.8.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" />
    <PackageVersion Include="Microsoft.Build.Locator" Version="1.7.8" />

    <!-- Core (netstandard2.0 only) -->
    <PackageVersion Include="System.Memory" Version="4.5.5" />
    <PackageVersion Include="System.Collections.Immutable" Version="7.0.0" />
    <PackageVersion Include="PolySharp" Version="1.15.0" />

    <!-- CLI / LSP -->
    <PackageVersion Include="System.CommandLine" Version="2.0.0" />
    <PackageVersion Include="OmniSharp.Extensions.LanguageServer" Version="0.19.9" />

    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.2" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing" Version="1.1.2" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.2" />
  </ItemGroup>
</Project>
