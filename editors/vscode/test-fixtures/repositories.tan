// Reference example from TANGENT-PLAN.md section 5.4 — repositories.tan
contract Repository {
    match: class in Infrastructure where name ends with "Repository"

    implements I{Name}
    interface I{Name} lives in Domain
    sealed

    ctor { injects only OrdersDbContext }
    methods where public { returns Task<*> }

    forbid using Orders.Api.**
}

/* Template forms the grammar must colour:
   {Name}, {Namespace}, {Name:strip Suffix} */
contract Handler {
    match: class in Application where name ends with "Handler"

    implements IRequestHandler<*>
    interface I{Name:strip Handler} lives in Domain
    namespace {Namespace}
}
