<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Tangent.Cli</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>tangent</ToolCommandName>
    <PackageId>Tangent.Cli</PackageId>
    <Description>dotnet tangent: check, lint, diff, graph, init, serve.</Description>
    <RollForward>Major</RollForward>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Microsoft.Build.Locator" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" VersionOverride="5.0.0" />
    <ProjectReference Include="../Tangent.Core/Tangent.Core.csproj" />
    <ProjectReference Include="../Tangent.Analyzers/Tangent.Analyzers.csproj" />
    <ProjectReference Include="../Tangent.Graph/Tangent.Graph.csproj" />
    <ProjectReference Include="../Tangent.LanguageServer/Tangent.LanguageServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kestrel, for the serve mode of `tangent graph`. A .NET tool runs where the SDK is, and the SDK has this runtime. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tangent.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!--
    The viewer for the serve mode of `tangent graph`: the build of viewer/ (`npm ci` and `npm run build` there) when it
    exists. Only what the page loads is embedded: no source maps, and no *.local.graph.json, which records an
    absolute path.
  -->
  <PropertyGroup>
    <TangentViewerDist>$(MSBuildThisFileDirectory)../../viewer/dist/</TangentViewerDist>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(TangentViewerDist)index.html')">
    <EmbeddedResource Include="$(TangentViewerDist)index.html;$(TangentViewerDist)favicon.svg;$(TangentViewerDist)*.graph.json"
                      Exclude="$(TangentViewerDist)*.local.graph.json"
                      LogicalName="viewer/%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(TangentViewerDist)assets/**/*"
                      Exclude="$(TangentViewerDist)assets/**/*.map"
                      LogicalName="viewer/assets/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- A release must carry the viewer: release.yml passes -p:TangentRequireViewer=true. -->
  <Target Name="TangentCheckViewer" BeforeTargets="GenerateNuspec" Condition="!Exists('$(TangentViewerDist)index.html')">
    <Error Condition="'$(TangentRequireViewer)' == 'true'"
           Text="viewer/dist is missing. Run 'npm ci' and 'npm run build' in viewer/ before the pack." />
    <Warning Condition="'$(TangentRequireViewer)' != 'true'"
             Text="viewer/dist is missing, so this Tangent.Cli package has no viewer and 'tangent graph --serve' cannot start. Run 'npm ci' and 'npm run build' in viewer/ before the pack." />
  </Target>

</Project>
