// Explicit bindings and the escape hatches. Every exemption carries a reason and
// is surfaced by `tangent check --show-exemptions`.

bind Orders.Api.Controllers.HealthController to Controller except [ProducesResponseType]

exempt Orders.Infrastructure.Repositories.LegacyReportRepository reason "migrating in Q4 2026"
exempt Orders.Domain.Entities.AuditEntry from Entity reason "append-only log, public setters by design"
