// Explicit bindings and the escape hatches. Every ignore carries a reason and
// is surfaced by `tangent check --show-ignored`.

bind Orders.Api.Controllers.HealthController to Controller except [ProducesResponseType]

ignore Orders.Infrastructure.Repositories.LegacyReportRepository reason "migrating in Q4 2026"
ignore Orders.Domain.Entities.AuditEntry from Entity reason "append-only log, public setters by design"
